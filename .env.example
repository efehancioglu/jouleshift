# ══════════════════════════════════════════════════════════════
#  JouleShift OS — ortam değişkenleri
#  Bu dosyayı .env olarak kopyala ve değerleri kendine göre doldur:
#     cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ─── Altyapı portları (Adım 1) ────────────────────────────────
MQTT_PORT=1883
REDIS_PORT=6379

# ─── Servislerin birbirini bulduğu adresler (Adım 1) ──────────
# Konteyner içinden bakıldığında servis adı, host'tan bakıldığında localhost
MQTT_HOST=localhost
REDIS_HOST=localhost

# ─── MQTT konu kökü (Adım 2) ──────────────────────────────────
MQTT_TOPIC_ROOT=jouleshift
MQTT_CLIENT_ID_PREFIX=jouleshift

# ─── Simülasyon ölçeği (Adım 2–3) ─────────────────────────────
SIM_ROOM_COUNT=50
SIM_EV_CHARGER_COUNT=10
SIM_TELEMETRY_INTERVAL_SECONDS=1
SIM_EV_NOMINAL_KW=22.0

# ─── Şebeke sözleşmesi ve puant eşikleri (Adım 5) ─────────────
CONTRACT_POWER_KW=500
DEMAND_ENGAGE_KW=480
DEMAND_RELEASE_KW=440
MIN_DWELL_SECONDS=300
DEMAND_WINDOW_MINUTES=15
EV_SHED_TARGET_KW=7.0

# ─── Emniyet kilitleri (Adım 6) ───────────────────────────────
AUTONOMOUS_DEFAULT=true
MAX_ROOM_SETPOINT_C=26.0
MAX_SHED_SECONDS=1800
MAX_CMD_PER_MIN=4
CRITICAL_LOADS=server_room,elevator

# ─── Tarife parametreleri (Adım 8) ────────────────────────────
# UYARI: Bu değerler ÖRNEKTİR, doğrulanmamıştır.
# Güncel değerleri EPDK ve kendi dağıtım şirketinden teyit et.
TARIFF_ENERGY_DAY_TL_PER_KWH=0.00
TARIFF_ENERGY_PEAK_TL_PER_KWH=0.00
TARIFF_ENERGY_NIGHT_TL_PER_KWH=0.00
TARIFF_DEMAND_TL_PER_KW=0.00
TARIFF_OVERAGE_MULTIPLIER=1.0
TARIFF_DAY_START=06:00
TARIFF_PEAK_START=17:00
TARIFF_NIGHT_START=22:00

# ─── TimescaleDB (Adım 7 — henüz kullanılmıyor) ───────────────
POSTGRES_PORT=5432
POSTGRES_DB=jouleshift
POSTGRES_USER=jouleshift
POSTGRES_PASSWORD=degistir-beni
DB_BATCH_SIZE=500
DB_FLUSH_INTERVAL_SECONDS=2
DB_QUEUE_CAPACITY=20000

# ─── AI servisi (Adım 13 — henüz kullanılmıyor) ───────────────
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
FORECAST_HORIZON_HOURS=4

# ─── Saha konumu (Adım 2) ─────────────────────────────────────
SITE_NAME=Istanbul Ofis Plaza
SITE_LATITUDE=41.0082
SITE_LONGITUDE=28.9784
SITE_TIMEZONE=Europe/Istanbul

# ─── Hava durumu servisi (Adım 2) ─────────────────────────────
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_FETCH_INTERVAL_SECONDS=3600
WEATHER_FORECAST_HOURS=48
WEATHER_HTTP_TIMEOUT_SECONDS=10
WEATHER_MAX_RETRIES=3
WEATHER_FALLBACK_ENABLED=true

# ─── Simülasyon zamanı (Adım 2) ───────────────────────────────
SIM_TICK_SECONDS=1.0
SIM_TIME_SCALE=1.0

# ─── Oda geometrisi ve termal model (Adım 2) ──────────────────
ROOM_FLOOR_AREA_M2=100.0
ROOM_HEIGHT_M=3.0
ROOM_THERMAL_CAPACITY_KJ_PER_M2_K=150.0
ROOM_ENVELOPE_UA_W_PER_K=20.0
ROOM_VENTILATION_ACH=1.0
ROOM_HVAC_RATED_KW=3.0
ROOM_HVAC_COP=3.0
ROOM_SETPOINT_DEFAULT_C=23.0
ROOM_SETPOINT_DEADBAND_C=0.5
ROOM_INITIAL_TEMP_C=24.0

# ─── İç kazançlar (Adım 2) ────────────────────────────────────
PERSON_HEAT_W=100.0
PLUG_LOAD_W_PER_M2=7.0
LIGHTING_LOAD_W_PER_M2=8.0

# ─── CO2 dengesi (Adım 2) ─────────────────────────────────────
CO2_OUTDOOR_PPM=420.0
CO2_PER_PERSON_L_PER_S=0.0052

# ─── Doluluk takvimi (Adım 2) ─────────────────────────────────
OCCUPANCY_MAX_PER_ROOM=4
OCCUPANCY_WORKDAY_START=08:00
OCCUPANCY_WORKDAY_END=18:00
OCCUPANCY_LUNCH_START=12:00
OCCUPANCY_LUNCH_END=13:00
OCCUPANCY_LUNCH_FACTOR=0.4
OCCUPANCY_WEEKEND_FACTOR=0.05

# ─── Güneş kazancı (Adım 2) ───────────────────────────────────
ROOM_WINDOW_AREA_M2=25.0
ROOM_WINDOW_SHGC=0.35
ROOM_SHADING_FACTOR=0.60
ROOM_SOLAR_ORIENTATION_FACTOR=0.75