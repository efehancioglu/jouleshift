# Varsayılan: metin dosyalarını depoda LF olarak sakla
* text=auto eol=lf

# Docker/Linux tarafından okunacak dosyalar kesinlikle LF olmalı
*.sh      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.sql     text eol=lf
Dockerfile text eol=lf

# Windows'a özgü betikler CRLF kalsın
*.bat     text eol=crlf
*.ps1     text eol=crlf

# İkili dosyalar: Git bunlara dokunmasın, diff almaya çalışmasın
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.woff2   binary

# SVG metindir, diff'i anlamlıdır
*.svg     text eol=lf